FROM python:3.11-slim

# Bake in the real Gemma tokenizer? Default 0 = use chars/3.5 heuristic.
# Set INSTALL_TOKENIZER=1 to opt in; requires HF access AND license
# acceptance for the gated model, supplied via --secret id=hf_token.
ARG INSTALL_TOKENIZER=0

RUN apt-get update && apt-get install -y --no-install-recommends curl pandoc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
# Only pull transformers (~large wheel) when the tokenizer is actually wanted.
RUN if [ "$INSTALL_TOKENIZER" = "1" ]; then \
        pip install --no-cache-dir ".[tokenizer]"; \
    else \
        pip install --no-cache-dir .; \
    fi

COPY navigator ./navigator

# Pre-download tokenizer files only when opted in. Uses an optional BuildKit
# secret so the gated-model token never lands in an image layer.
RUN --mount=type=secret,id=hf_token,required=false \
    if [ "$INSTALL_TOKENIZER" = "1" ]; then \
        HF_HOME=/app/.cache/huggingface \
        HF_TOKEN="$(cat /run/secrets/hf_token 2>/dev/null || echo '')" \
        python -c "from transformers import AutoTokenizer; \
            AutoTokenizer.from_pretrained('google/gemma-2-2b-it')" \
        && chmod -R a+rX /app/.cache; \
    fi

# Offline mode only matters when the tokenizer was baked in. Harmless
# otherwise; also means any stray import inside the container fails fast
# to the heuristic instead of hanging on DNS.
ENV HF_HOME=/app/.cache/huggingface \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

RUN useradd -m -u 1000 maestro
USER maestro

# No NAVIGATOR_DATABASE_URL default. The service must be told where its
# database is — a silent SQLite fallback was worse than a startup failure,
# because it hid the fact that the operator hadn't configured the deploy.
ENV NAVIGATOR_SANITIZER_ENDPOINT="http://sanitizer:8000/ingest" \
    NAVIGATOR_PHOTON_ENDPOINT="http://photon:2322" \
    NAVIGATOR_OLLAMA_ENDPOINT="http://host.docker.internal:11434"

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -sf http://127.0.0.1:8001/api/health || exit 1

CMD ["python", "-m", "navigator", "--host", "0.0.0.0", "--port", "8001"]